rules_version = '2';

// 일기장 보안 규칙
// - 구글로 로그인한 사람만, 자기 자신의 일기(users/{내 uid}/entries)만 읽고 쓸 수 있어요.
// - 다른 사람 일기, 그 밖의 모든 데이터는 아무도 읽고 쓸 수 없어요.
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 통째로 붙여 넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEntry(request.resource.data);
    }

    // 위에 적힌 곳 말고는 전부 막아요.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['date', 'title', 'body', 'mood', 'weather', 'tags', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.title is string && d.title.size() <= 100
        && d.body is string && d.body.size() <= 50000
        && d.mood is string && d.mood.size() <= 8
        && d.weather is string && d.weather.size() <= 20
        && d.tags is list && d.tags.size() <= 10
        && d.updatedAt is timestamp;
    }
  }
}
